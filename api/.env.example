# Copy this file to .env and replace placeholders with your own credentials.
SECRET_KEY=generate-a-long-random-flask-secret
JWT_SECRET_KEY=generate-a-different-long-random-jwt-secret

# Use the matching test-mode pair while testing; use live keys only for production.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

SHIPROCKET_EMAIL=your-shiprocket-login-email
SHIPROCKET_PASSWORD=your-shiprocket-password
# Must exactly match a pickup location configured in your Shiprocket account.
SHIPROCKET_PICKUP_LOCATION=Primary

# Optional email OTP delivery settings.
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional Firebase phone verification settings.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
